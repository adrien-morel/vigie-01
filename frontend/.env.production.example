# Copy to .env.production before `npm run build` for a Firebase Hosting deployment.
# VITE_API_BASE is read at build time (frontend/src/api.ts) and frozen into the bundle: changing the
# API URL therefore means rebuilding and redeploying the front, not merely restarting the service.
#
# The URL is that of the Cloud Run service serving GET /events. The front and the API sit on two
# different origins (Firebase Hosting on one side, Cloud Run on the other): the front's origin must
# appear in ALLOWED_ORIGINS on the service side, or the browser will refuse the response.
VITE_API_BASE=https://vigie-api-93473671813.europe-west1.run.app
