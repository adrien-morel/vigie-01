# Copier en .env.production avant `npm run build` pour un deploiement Firebase Hosting.
# VITE_API_BASE est lu a la construction (frontend/src/api.ts) et fige dans le bundle : changer
# l'URL de l'API impose donc de reconstruire et redeployer le front, pas seulement de redemarrer
# le service.
#
# L'URL est celle du service Cloud Run qui sert GET /events. Le front et l'API sont sur deux
# origines differentes (Firebase Hosting d'un cote, Cloud Run de l'autre) : l'origine du front doit
# figurer dans ALLOWED_ORIGINS cote service, sinon le navigateur refusera la reponse.
VITE_API_BASE=https://vigie-api-93473671813.europe-west1.run.app
