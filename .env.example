ANTHROPIC_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=veille-01

# Plafonds (garde-fous obligatoires, cf. docs/cadrage.md section 7) — pas de valeur par défaut dans le code,
# le service doit refuser de démarrer si ces valeurs ne sont pas explicitement définies.
MAX_STEPS_PER_RUN=20
MAX_LLM_CALLS_PER_DAY=200

# Persistance (backend/memory/persistence.py) : "local" (fichiers JSON, défaut) ou "firestore".
# Contrairement aux plafonds ci-dessus, l'absence de valeur n'est pas une config incomplète mais le
# cas de développement normal — rien ne doit partir vers GCP sans choix explicite.
#
# Le disque de Cloud Run est éphémère et propre à chaque instance : en "local" sur Cloud Run, le
# compteur de budget LLM repartirait de zéro à chaque cold start (garde-fou contournable par un
# redémarrage), le dédoublonnage repaierait des appels déjà consommés, et le digest disparaîtrait.
# En production, "firestore" est donc obligatoire, pas optionnel.
VIGIE_STORAGE=local
# FIRESTORE_PROJECT=      # requis si VIGIE_STORAGE=firestore
# FIRESTORE_DATABASE=(default)

# Exposition de l'API (backend/api/main.py) — a renseigner avant tout deploiement.
# RUN_TOKEN ferme POST /run, qui declenche un run complet : sans jeton, l'endpoint repond 503
# plutot que de rester ouvert (il brule le budget quotidien et une facture d'API). Cloud Scheduler
# pose ce jeton en en-tete X-Run-Token sur son appel. GET /events reste public : c'est ce que lit
# le navigateur, et il ne coute rien.
RUN_TOKEN=
# Origines autorisees a appeler l'API depuis un navigateur, separees par des virgules. Defaut :
# le serveur de developpement Vite. En production, l'URL reelle du front.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Journalisation (backend/logging_setup.py). "json" est le format que Cloud Logging parse en
# jsonPayload ; "text" est un repli lisible a l'oeil pour le developpement local.
VIGIE_LOG_FORMAT=json
VIGIE_LOG_LEVEL=INFO
