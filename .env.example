ANTHROPIC_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
# The one string not renamed with the rest: changing it starts a new LangSmith project and cuts the
# tracing history in two. Kept deliberately.
LANGCHAIN_PROJECT=veille-01

# Caps (mandatory guardrails, see docs/scoping.md section 7) — no default value in the code, the
# service must refuse to start if these values are not explicitly defined.
MAX_STEPS_PER_RUN=20
MAX_LLM_CALLS_PER_DAY=200

# Persistence (backend/memory/persistence.py): "local" (JSON files, the default) or "firestore".
# Unlike the caps above, a missing value here is not an incomplete config but the normal development
# case — nothing should reach GCP without an explicit choice.
#
# Cloud Run's disk is ephemeral and specific to each instance: in "local" mode on Cloud Run, the LLM
# budget counter would restart from zero on every cold start (a guardrail circumventable by a
# restart), deduplication would pay again for calls already consumed, and the digest would disappear.
# In production, "firestore" is therefore mandatory, not optional.
VIGIE_STORAGE=local
# FIRESTORE_PROJECT=      # required if VIGIE_STORAGE=firestore
# FIRESTORE_DATABASE=(default)

# API exposure (backend/api/main.py) — to be filled in before any deployment.
# RUN_TOKEN closes POST /run, which triggers a full run: with no token, the endpoint answers 503
# rather than staying open (it burns the daily budget and an API bill). Cloud Scheduler sets this
# token as an X-Run-Token header on its call. GET /events stays public: that is what the browser
# reads, and it costs nothing.
RUN_TOKEN=
# Origins allowed to call the API from a browser, comma-separated. Default: the Vite development
# server. In production, the front's real URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging (backend/logging_setup.py). "json" is the format Cloud Logging parses into jsonPayload;
# "text" is a human-readable fallback for local development.
VIGIE_LOG_FORMAT=json
VIGIE_LOG_LEVEL=INFO
