# The image carries only backend/ (see Dockerfile). Everything else is excluded explicitly: the front
# is deployed separately on Firebase Hosting, and local state must never ship inside an image.
.git
.github
.venv
frontend
tests
scripts
docs
infra
*.private.md
CLAUDE.md
.env
.env.example
**/__pycache__
**/.pytest_cache
**/.ruff_cache
# Local persistence state: a history or a budget counter baked into the image would overwrite the
# target environment's on the first start.
backend/.llm_budget.json
backend/memory/.seen_items.json
backend/memory/.analyzed_history.json
backend/eval/*.json
